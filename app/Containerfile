# ---------- Order API image ----------

FROM docker.io/library/python:3.12-slim

LABEL maintainer="platform-team@shopease.example" \
      app="shopease-order-api" \
      version="1.0"

WORKDIR /app

# Install dependencies first to use layer caching
COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .

# Run as a non-root user
RUN useradd --uid 1001 --no-create-home appuser

USER 1001

EXPOSE 5000

# Production WSGI server instead of Flask dev server
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "app:app"]
